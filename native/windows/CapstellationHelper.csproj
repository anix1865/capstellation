<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capstellation's Windows helper: reports what's playing (Windows media controls, which Spotify,
    Apple Music, browsers etc. all publish to) and listens to the computer's audio output (WASAPI
    loopback — never a microphone). Started by the desktop app; speaks the same line protocol as
    audiotap.swift on macOS.

      dotnet publish native/windows -c Release -o desktop/native-bin/win
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>capstellation-helper</AssemblyName>
    <RootNamespace>Capstellation</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
